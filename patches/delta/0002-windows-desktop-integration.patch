-pub fn show_desktop_notification(_title: &str, _body: Option<&str>) -> std::io::Result<bool> {
-    Ok(false)
+pub fn show_desktop_notification(title: &str, body: Option<&str>) -> std::io::Result<bool> {
+    let title = title.to_owned();
+    let body = body.map(str::to_owned);
+    let (ready_tx, ready_rx) = std::sync::mpsc::sync_channel(1);
+    std::thread::Builder::new()
+        .name("herdr-desktop-notification".into())
+        .spawn(move || run_desktop_notification(&title, body.as_deref(), ready_tx))?;
+
+    match ready_rx.recv_timeout(NOTIFICATION_SETUP_TIMEOUT) {
+        Ok(result) => result.map(|()| true),
+        Err(std::sync::mpsc::RecvTimeoutError::Timeout) => Err(std::io::Error::new(
+            std::io::ErrorKind::TimedOut,
+            "Windows desktop notification setup timed out",
+        )),
+        Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => Err(std::io::Error::other(
+            "Windows desktop notification worker exited during setup",
+        )),
+    }
+}
+
+fn run_desktop_notification(
+    title: &str,
+    body: Option<&str>,
+    ready: std::sync::mpsc::SyncSender<std::io::Result<()>>,
+) {
+    let hwnd = match create_notification_window() {
+        Ok(hwnd) => hwnd,
+        Err(err) => {
+            let _ = ready.send(Err(err));
+            return;
+        }
+    };
+
+    if let Err(err) = add_notification_icon(hwnd, title, body) {
+        unsafe {
+            DestroyWindow(hwnd);
+        }
+        let _ = ready.send(Err(err));
+        return;
+    }
+
+    if unsafe {
+        SetTimer(
+            hwnd,
+            NOTIFICATION_TIMER_ID,
+            NOTIFICATION_QUEUE_TIMEOUT_MILLIS,
+            None,
+        )
+    } == 0
+    {
+        let err = std::io::Error::last_os_error();
+        remove_notification_icon(hwnd);
+        let _ = ready.send(Err(err));
+        return;
+    }
+
+    if ready.send(Ok(())).is_err() {
+        remove_notification_icon(hwnd);
+        return;
+    }
+
+    if let Err(err) = notification_message_loop(hwnd) {
+        tracing::warn!(err = %err, "Windows desktop notification message loop failed");
+    }
+    remove_notification_icon(hwnd);
+}
+
+fn create_notification_window() -> std::io::Result<HWND> {
+    let module = unsafe { GetModuleHandleW(std::ptr::null()) };
+    if module.is_null() {
+        return Err(std::io::Error::last_os_error());
+    }
+
+    let class_atom = NOTIFICATION_WINDOW_CLASS.get_or_init(|| {
+        let class_name = wide_null("HerdrDesktopNotificationWindow");
+        let window_class = WNDCLASSW {
+            lpfnWndProc: Some(notification_window_proc),
+            hInstance: module,
+            lpszClassName: class_name.as_ptr(),
+            ..unsafe { std::mem::zeroed() }
+        };
+        let atom = unsafe { RegisterClassW(&window_class) };
+        if atom == 0 {
+            Err(std::io::Error::last_os_error().raw_os_error().unwrap_or(1))
+        } else {
+            Ok(atom)
+        }
+    });
+    let class_atom = (*class_atom).map_err(std::io::Error::from_raw_os_error)?;
+    let atom_pointer = usize::from(class_atom) as *const u16;
+    let hwnd = unsafe {
+        CreateWindowExW(
+            0,
+            atom_pointer,
+            std::ptr::null(),
+            0,
+            0,
+            0,
+            0,
+            0,
+            HWND_MESSAGE,
+            null_mut(),
+            module,
+            std::ptr::null(),
+        )
+    };
+    if hwnd.is_null() {
+        Err(std::io::Error::last_os_error())
+    } else {
+        Ok(hwnd)
+    }
+}
+
+fn add_notification_icon(hwnd: HWND, title: &str, body: Option<&str>) -> std::io::Result<()> {
+    let mut notification = notification_identity(hwnd);
+    notification.hIcon = unsafe { LoadIconW(null_mut(), IDI_APPLICATION) };
+    notification.uCallbackMessage = NOTIFICATION_CALLBACK_MESSAGE;
+    notification.uFlags = NIF_MESSAGE | NIF_TIP;
+    if !notification.hIcon.is_null() {
+        notification.uFlags |= NIF_ICON;
+    }
+    copy_wide_truncated(&mut notification.szTip, "Herdr");
+
+    if unsafe { Shell_NotifyIconW(NIM_ADD, &notification) } == 0 {
+        return Err(std::io::Error::other(
+            "failed to add Herdr notification-area icon",
+        ));
+    }
+
+    notification.Anonymous.uVersion = NOTIFYICON_VERSION_4;
+    if unsafe { Shell_NotifyIconW(NIM_SETVERSION, &notification) } == 0 {
+        delete_notification_icon(hwnd);
+        return Err(std::io::Error::other(
+            "failed to set Herdr notification-area icon version",
+        ));
+    }
+
+    notification.uFlags = NIF_INFO;
+    notification.dwInfoFlags = NIIF_INFO | NIIF_NOSOUND;
+    copy_wide_truncated(&mut notification.szInfoTitle, title);
+    copy_wide_truncated(&mut notification.szInfo, body.unwrap_or(title));
+    if unsafe { Shell_NotifyIconW(NIM_MODIFY, &notification) } == 0 {
+        delete_notification_icon(hwnd);
+        return Err(std::io::Error::other(
+            "failed to show Herdr desktop notification",
+        ));
+    }
+
+    Ok(())
+}
+
+fn notification_message_loop(hwnd: HWND) -> std::io::Result<()> {
+    let mut message = unsafe { std::mem::zeroed::<MSG>() };
+    loop {
+        let result = unsafe { GetMessageW(&mut message, hwnd, 0, 0) };
+        if result == -1 {
+            return Err(std::io::Error::last_os_error());
+        }
+        if result == 0 {
+            return Ok(());
+        }
+        unsafe {
+            TranslateMessage(&message);
+            DispatchMessageW(&message);
+        }
+    }
+}
+
+unsafe extern "system" fn notification_window_proc(
+    hwnd: HWND,
+    message: u32,
+    wparam: usize,
+    lparam: isize,
+) -> isize {
+    if message == NOTIFICATION_CALLBACK_MESSAGE {
+        match notification_event(lparam) {
+            NIN_BALLOONSHOW => unsafe {
+                SetTimer(
+                    hwnd,
+                    NOTIFICATION_TIMER_ID,
+                    NOTIFICATION_VISIBLE_TIMEOUT_MILLIS,
+                    None,
+                );
+            },
+            NIN_BALLOONHIDE | NIN_BALLOONTIMEOUT | NIN_BALLOONUSERCLICK => unsafe {
+                PostQuitMessage(0);
+            },
+            _ => {}
+        }
+        return 0;
+    }
+    if message == WM_TIMER && wparam == NOTIFICATION_TIMER_ID {
+        unsafe {
+            PostQuitMessage(0);
+        }
+        return 0;
+    }
+
+    unsafe { DefWindowProcW(hwnd, message, wparam, lparam) }
+}
+
+fn notification_event(lparam: isize) -> u32 {
+    (lparam as u32) & 0xffff
+}
+
+fn notification_identity(hwnd: HWND) -> NOTIFYICONDATAW {
+    let mut notification = unsafe { std::mem::zeroed::<NOTIFYICONDATAW>() };
+    notification.cbSize = size_of::<NOTIFYICONDATAW>() as u32;
+    notification.hWnd = hwnd;
+    notification.uID = NOTIFICATION_ICON_ID;
+    notification
+}
+
+fn delete_notification_icon(hwnd: HWND) {
+    let notification = notification_identity(hwnd);
+    unsafe {
+        Shell_NotifyIconW(NIM_DELETE, &notification);
+    }
+}
+
+fn remove_notification_icon(hwnd: HWND) {
+    unsafe {
+        KillTimer(hwnd, NOTIFICATION_TIMER_ID);
+    }
+    delete_notification_icon(hwnd);
+    unsafe {
+        DestroyWindow(hwnd);
+    }
+}
+
+fn copy_wide_truncated<const N: usize>(destination: &mut [u16; N], value: &str) {
+    destination.fill(0);
+    let mut offset = 0;
+    for ch in value.chars() {
+        let mut units = [0; 2];
+        let encoded = ch.encode_utf16(&mut units);
+        if offset + encoded.len() >= N {
+            break;
+        }
+        destination[offset..offset + encoded.len()].copy_from_slice(encoded);
+        offset += encoded.len();
+    }
 }
 
