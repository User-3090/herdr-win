+
+fn custom_preview_update_manifest_url() -> Option<&'static str> {
+    option_env!("HERDR_PREVIEW_MANIFEST_URL").and_then(|value| {
+        let value = value.trim();
+        (!value.is_empty()).then_some(value)
+    })
+}
+
+fn preview_update_manifest_url() -> &'static str {
+    custom_preview_update_manifest_url().unwrap_or(DEFAULT_PREVIEW_UPDATE_MANIFEST_URL)
+}
+
+#[cfg(windows)]
+fn windows_installer_url() -> &'static str {
+    option_env!("HERDR_WINDOWS_INSTALLER_URL")
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+        .unwrap_or(DEFAULT_WINDOWS_INSTALLER_URL)
+}
