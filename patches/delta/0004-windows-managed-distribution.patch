+        );
+        assert!(install
+            .read_pointer(PENDING_POINTER)
+            .expect("pending pointer")
+            .is_none());
+
+        descendant_stream
+            .write_all(b"x")
+            .expect("release payload descendant");
+        descendant_guard.wait(HELPER_TIMEOUT);
+    }
