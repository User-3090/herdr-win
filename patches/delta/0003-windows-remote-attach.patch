+        let mut download_stream = listener.accept().unwrap();
+        let upload_stream = download_stream.try_clone().unwrap();
+        crate::ipc::set_local_stream_nonblocking(&mut download_stream, true).unwrap();
+
+        let connection_stop = Arc::new(AtomicBool::new(false));
+        let bridge_stop = Arc::new(AtomicBool::new(false));
